# ─────────────────────────────────────────────
# App Học Tiếng Anh + AI — Backend .env.example
# Copy file này thành .env, điền giá trị thật
# KHÔNG commit .env vào git!
# ─────────────────────────────────────────────

# ── App ──────────────────────────────────────
APP_ENV=development
DEBUG=true
API_V1_PREFIX=/api/v1
# Danh sách origins cho phép CORS (phân tách bằng dấu phẩy)
# Dev: thêm địa chỉ Flutter web/emulator nếu cần
CORS_ORIGINS=http://localhost:3000,http://localhost:8000
LOG_LEVEL=INFO

# ── PostgreSQL ────────────────────────────────
DATABASE_URL=postgresql+asyncpg://postgres:password@localhost:5432/english_ai
# Pool
DATABASE_POOL_SIZE=10
DATABASE_MAX_OVERFLOW=20

# ── Redis / ARQ ───────────────────────────────
REDIS_URL=redis://localhost:6379/0

# ── Auth (JWT) ────────────────────────────────
# Tạo secret mạnh: python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET_KEY=REPLACE_WITH_STRONG_SECRET_MIN_64_CHARS
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=30

# ── Storage (Cloudflare R2 hoặc AWS S3) ───────
STORAGE_ENDPOINT=https://ACCOUNT_ID.r2.cloudflarestorage.com
STORAGE_REGION=auto
STORAGE_BUCKET_PRIVATE=scans-private
STORAGE_BUCKET_PUBLIC=content-public
STORAGE_ACCESS_KEY=your-r2-access-key-id
STORAGE_SECRET_KEY=your-r2-secret-access-key
# TTL presigned URL cho ảnh scan private (giây)
STORAGE_PRESIGN_TTL=3600

# ── Gemini API (Google AI Studio) ─────────────
# Lấy key tại: https://aistudio.google.com/apikey
GEMINI_API_KEY=AIzaSy...your-key-here
GEMINI_MODEL=gemini-2.0-flash
GEMINI_TIMEOUT=30

# ── AI Safety & Quota ─────────────────────────
# Lượt scan tối đa mỗi user mỗi ngày
SCAN_QUOTA_PER_USER_DAILY=10
# Tổng request Gemini hệ thống mỗi ngày (system budget)
SCAN_SYSTEM_BUDGET_DAILY=500

# ── Email (Resend) ────────────────────────────
# Lấy key tại: https://resend.com/api-keys
RESEND_API_KEY=re_...your-key-here
EMAIL_FROM=noreply@yourdomain.com

# ── Firebase Cloud Messaging (FCM) ────────────
# Đường dẫn tới file service account JSON (server-side only)
FIREBASE_CREDENTIALS_PATH=/secrets/firebase-service-account.json
